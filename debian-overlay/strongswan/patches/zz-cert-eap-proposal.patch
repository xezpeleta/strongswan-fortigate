diff --git a/src/libcharon/sa/ikev2/tasks/ike_cert_post.c b/src/libcharon/sa/ikev2/tasks/ike_cert_post.c
index 5edc4ff9e0..3a574fb183 100644
--- a/src/libcharon/sa/ikev2/tasks/ike_cert_post.c
+++ b/src/libcharon/sa/ikev2/tasks/ike_cert_post.c
@@ -286,8 +286,28 @@ static void build_certs(private_ike_cert_post_t *this, message_t *message)
 
 	payload = (auth_payload_t*)message->get_payload(message, PLV2_AUTH);
 	peer_cfg = this->ike_sa->get_peer_cfg(this->ike_sa);
-	if (!peer_cfg || !payload || payload->get_auth_method(payload) == AUTH_PSK)
-	{	/* no CERT payload for EAP/PSK */
+	if (!peer_cfg)
+	{
+		return;
+	}
+	if (!payload)
+	{	/* EAP-only authentication: only the first IKE_AUTH request sent by
+		 * the initiator contains an IDi payload but no AUTH payload.  If
+		 * sending a certificate was explicitly enabled (CERT_ALWAYS_SEND),
+		 * send the certificate configured for the local EAP auth round.
+		 * This is not currently defined by the RFCs, but it allows gateways
+		 * to validate the client certificate during EAP authentication
+		 * (e.g. FortiGate's eap-cert-auth). */
+		if (message->get_exchange_type(message) != IKE_AUTH ||
+			!message->get_request(message) ||
+			!message->get_payload(message, PLV2_ID_INITIATOR) ||
+			peer_cfg->get_cert_policy(peer_cfg) != CERT_ALWAYS_SEND)
+		{
+			return;
+		}
+	}
+	else if (payload->get_auth_method(payload) == AUTH_PSK)
+	{	/* no CERT payload for PSK */
 		return;
 	}
 
