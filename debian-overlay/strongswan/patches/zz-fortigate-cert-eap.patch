+		if (message->get_exchange_type(message) != IKE_AUTH ||
+			!message->get_request(message) ||
+			message->get_message_id(message) != 1)
+		{
+			return;
+		}
+	}
+	else if (payload->get_auth_method(payload) == AUTH_PSK)
+	{	/* no CERT payload for PSK */
